---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site_config } from '../lib/site';
---

<BaseLayout title="About" current="about">
  <article class="article">
    <h1 class="page-title">About</h1>
    <p>
      I'm TC. I love building things — especially when I get to point AI at
      finance and see what happens.
    </p>
    <p>A favorite quote I live by:</p>
    <blockquote>
      <p>
        you could outsource your knowledge, but you can't outsource your
        understanding
      </p>
    </blockquote>
    <p><strong>I love:</strong></p>
    <ul>
      <li>Building, and solving the problems that refuse to stay theoretical.</li>
      <li>Sharing the engineering thinking that makes real problems give way.</li>
    </ul>
    <p class="muted">{site_config.author} / {site_config.github_username}</p>
  </article>
</BaseLayout>
